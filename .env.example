# ── IdentityHub environment ──────────────────────────────────────────────────
# Quick start: run `npm run setup` — it copies this file to .env and generates
# the two secrets below for you. You only fill in the Atlassian OAuth values.

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Browser origin of the app. Defaults: http://localhost:5173 in dev (Vite),
# http://localhost:<PORT> in production (server serves the built UI itself).
# Only set this if you changed ports.
# APP_URL=

# ── Secrets (auto-generated by `npm run setup`) ──────────────────────────────
# Signs the session cookie. Any long random string (min 32 chars).
SESSION_SECRET=generate-me-with-npm-run-setup
# Encrypts Jira OAuth tokens at rest (AES-256-GCM). Base64-encoded 32 bytes.
ENCRYPTION_KEY=generate-me-with-npm-run-setup

# ── Atlassian OAuth 2.0 (3LO) — REQUIRED ─────────────────────────────────────
# Signing in *is* the Atlassian OAuth flow, so the server refuses to start
# without these. Either paste the credentials you were given, or create an app
# at https://developer.atlassian.com/console/myapps/
# Full walkthrough: README → "Create your Atlassian OAuth app" (~5 minutes).
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
# Must match the callback URL configured in the Atlassian developer console
# EXACTLY (scheme, host, port, path):
ATLASSIAN_CALLBACK_URL=http://localhost:3000/api/auth/callback

# ── Storage ──────────────────────────────────────────────────────────────────
# SQLite database file, relative to the repository root.
DATABASE_PATH=./data/identityhub.db

# ── NHI Blog Digest (optional bonus feature) ─────────────────────────────────
# Required to run the digest: summaries come from Groq, and the digest refuses
# to start without a key. Free key: console.groq.com
# GROQ_API_KEY=
# App user whose Jira connection the digest uses (must have connected Jira once):
# DIGEST_USER_EMAIL=demo@identityhub.local
# Jira project that receives digest tickets:
# DIGEST_PROJECT_KEY=SEC
#
# The digest is a standalone script — run it with `npm run digest`. To put it on
# a schedule, use cron / Task Scheduler / a CI job rather than the app.
